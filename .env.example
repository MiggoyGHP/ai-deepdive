# AI-deepdive — environment template (committed to git)
#
# This file documents which environment variables the project uses.
# Copy it to `.env.local` (gitignored) and paste your real values there.
#
#   cp .env.example .env.local
#   # edit .env.local
#   python load_env.py

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
